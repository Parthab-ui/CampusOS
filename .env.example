# ==============================================================================
# AI Subscription Manager & FinTech Audit Tool - Environment Configuration
# Copy this file to `.env` or `.env.local` for local development.
# NEVER commit actual API keys or banking credentials to version control.
# ==============================================================================

# Application Environment
VITE_APP_NAME="AuditPulse AI"
VITE_APP_ENV="development"
VITE_APP_VERSION="0.1.0"

# Financial Data Mode ('mock' | 'live')
# In this foundation phase, only 'mock' synthetic data is used for safe development.
VITE_FINANCIAL_DATA_MODE="mock"

# Default Display Currency (ISO 4217 code)
VITE_DEFAULT_CURRENCY="USD"

# FinTech Audit Detection Thresholds
# Price hike alert trigger (e.g., alert if price increased by >= 5%)
VITE_AUDIT_PRICE_HIKE_THRESHOLD_PCT=5.0

# Zombie subscription inactivity detection (days without logged user activity)
VITE_AUDIT_ZOMBIE_DAYS_THRESHOLD=60

# Renewal Warning Radar Window (days ahead to flag upcoming charges)
VITE_AUDIT_RENEWAL_RADAR_DAYS=14

# ==============================================================================
# AI Financial Copilot (Google Gemini 3.5 / 2.5 Flash Free API)
# ==============================================================================
# The Gemini API key is loaded strictly on the server-side via the secure proxy
# and is NEVER bundled or exposed to frontend client code.
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Supported free models: 'gemini-2.5-flash', 'gemini-1.5-flash', 'gemini-2.0-flash'
GEMINI_MODEL="gemini-2.5-flash"
